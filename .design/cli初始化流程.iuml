@startuml
title CLI 初始化流程

start
:用户执行 vlt init;
:检查数据库;

if (key_pair 表有数据?) then (是)
    :提示“已初始化”;
    stop
else (否)
    :提示用户设置主密码;
    :输入主密码并确认\n两次输入不一致则退出;
    :输入密码提示（可选）;
    
    partition "1. 派生 K_master" {
        :生成随机盐 Salt\n  (32 bytes);
        :PBKDF2-HMAC-SHA512\n  迭代 600,000 次\n  派生 K_master (AES-256);
    }

    partition "2. 加密 Magic Text 验证" {
        :生成随机 Nonce (12 bytes);
        :用 K_master + AES-256-GCM 加密\n  "PWD_MASTER_VERIFY_OK" → cipher;
        :salt / nonce / cipher\n  存入 key_pair 表;
    }

    partition "3. 生成设备 RSA-3072 密钥对" {
        :生成 RSA-3072 密钥对\n  (私钥 + 公钥);
        :公钥编码为 PKCS1 DER → Base64;
        :私钥编码为 PKCS8 DER;
        :用 K_master + AES-256-GCM 加密\n  私钥 DER → encrypted_private_key;
        :encrypted_private_key → 存入 key_pair 表;
    }

    partition "4. 生成 Data Key" {
        :生成随机 Data Key (AES-256, 32 bytes);
        :用本机公钥 + OAEP-SHA512\n  加密 Data Key;
    }

    partition "5. 创建设备记录" {
        :生成设备 device_id (UUID v4);
        :获取设备名 (hostname);
        :设备信息 + 加密的 Data Key\n  → 存入 devices 表\n  is_current_device = true;
    }

    :提示“初始化完成”;
    stop
endif

@enduml