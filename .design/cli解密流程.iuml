@startuml
title CLI 解密流程

start
:用户执行需要解锁的命令\n(add/list/get/edit/delete/export/import/upload/download/regist);
:检查数据库中是否有该记录;

if (key_pair 表中无) then (是)
    :提示“未初始化”;
    stop
endif

:用户输入主密码 (read_pass);

partition "1. 主密码验证" {
    :从 key_pair 表读取 salt;
    :PBKDF2-HMAC-SHA512\n  迭代 600,000 次\n  派生 K_master (AES-256, 32 bytes);

    :从 key_pair 表读取\n  magic_text_iv + magic_text_cipher;
    :用 K_master + AES-256-GCM 解密\n  magic_text_cipher;

    if (解密结果 == "PWD_MASTER_VERIFY_OK"?) then (是)
        #LightGreen:主密码验证通过;
    else (否)
        #LightCoral:提示"主密码错误";
        stop
    endif
}

partition "2. 三层密钥解锁" {
    :从 key_pair 表读取 encrypted_private_key;
    :Base64 解码 → 收分为 iv + ct;
    :用 K_master + AES-256-GCM\n  解密 → RSA 私钥 PKCS8 DER;
    :PKCS8 DER → RsaPrivateKey 对象;

    :从 devices 表读取\n  is_current_device = true 的设备;
    :获取 encrypted_data_key;
    :Base64 解码;
    :用 RSA 私钥 + OAEP-SHA512\n  解密 → 32 bytes Data Key;
}

partition "3：暂存会话密钥" {
    :Data Key → **SESSION_KEY**\n  (OnceLock<Mutex<Option<[u8; 32]>>>);
    :RSA 私钥 → **SESSION_PRIV_KEY**\n  (OnceLock<Mutex<Option<RsaPrivateKey>>>);
    :返回解锁成功;
}

:执行具体命令;

partition "4. 字段加/解密（执行时调用）" {
    note right
    encrypt_field("明文")
    decrypt_field("base64(iv):base64(ct)")
    都直接使用 SESSION_KEY (Data Key)
    end note

    :encrypt_field → 获取 Data Key;
    :生成随机 Nonce (12 bytes);
    :AES-256-GCM: encrypted\n  →格式: base64(iv):base64(ct);

    :decrypt_field: 按第一行读取密文;
    :Base64 解码并分割 iv 和 ct;
    :AES-256-GCM 解密 → 明文;
}

stop
@enduml